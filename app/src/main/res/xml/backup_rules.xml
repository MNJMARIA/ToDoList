<?xml version="1.0" encoding="utf-8"?>
<!--
   Device-specific state must not travel to another phone with a backup:
   scheduled reminders (alarms do not exist there) and updater bookkeeping.
   Tasks, stats and profile live in Firebase, not in local files.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="reminders_store.xml" />
    <exclude domain="sharedpref" path="update_prefs.xml" />
</full-backup-content>

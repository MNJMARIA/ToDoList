<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup rules. See backup_rules.xml for the reasoning.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="reminders_store.xml" />
        <exclude domain="sharedpref" path="update_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="reminders_store.xml" />
        <exclude domain="sharedpref" path="update_prefs.xml" />
    </device-transfer>
</data-extraction-rules>

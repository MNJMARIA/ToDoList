<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ToDoList" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="headerBackground">@drawable/header</item>
        <item name="item1SettingsBackground">@drawable/round_back_secondary_100</item>
        <item name="item2SettingsBackground">@drawable/round_back_white10_20</item>
        <item name="statsItemBackground">@drawable/white_background</item>

        <item name="arrowBack">@drawable/baseline_arrow_back_24</item>
        <item name="rightArrow">@drawable/right_arrow_icon</item>
        <item name="moon">@drawable/night_mode</item>
        <item name="notifications">@drawable/notifications</item>
        <item name="languages">@drawable/languages</item>
        <item name="version">@drawable/version</item>
        <item name="lock">@drawable/ic_baseline_lock_24</item>
        <item name="email">@drawable/ic_baseline_email_24</item>
        <item name="account">@drawable/ic_baseline_person_pin_24</item>
        <item name="person">@drawable/ic_baseline_person_24</item>

        <item name="contentTextColor">@color/gray_faded</item>
        <item name="purpleTextColor">@color/purple</item>

        <item name="settingsBackground">@color/secondary_color</item>
        <item name="achievementsBackground">@color/white</item>
        <item name="verifyPasswordBackground">@color/white</item>
        <item name="lavender_border">@drawable/lavender_border</item>

        <item name="lavenderTextColor">@color/lavender</item>
        <item name="languageButton">@color/language_blue_color</item>
        <item name="verifyPasswordText">@color/white</item>

        <item name="exitButton">@color/gray_faded</item>
        <item name="exitText">@color/muted_black</item>

        <item name="buttonText">@color/white</item>

        <item name="bottomMenuBackground">@color/white</item>
        <item name="bottomMenuText">@color/muted_black</item>


        <item name="navDay">@drawable/nav_day</item>
        <item name="navMenu">@drawable/baseline_menu_24</item>
        <item name="navMonth">@drawable/nav_month</item>

        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary_color</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="textFillColor">@color/muted_black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" >@color/secondary_color</item>
    </style>
    <!--Theme style for Night Mode Switch-->
    <style name="nightModeSwitch" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated" >@color/night_mode</item>
        <item name="colorSwitchThumbNormal" >@color/night_mode</item>
        <item name="android:foreground" >#99FFFFFF</item>
    </style>

    <!--Theme style for Notifications Switch-->
    <style name="notificationsSwitch" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated" >@color/notifications</item>
        <item name="colorSwitchThumbNormal" >@color/notifications</item>
        <item name="android:foreground" >#99FFFFFF</item>
    </style>


</resources>

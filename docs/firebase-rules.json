{
  "rules": {
    ".read": false,
    ".write": false,

    "Users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "userId":   { ".validate": "newData.isString()" },
        "name":     { ".validate": "newData.isString() && newData.val().length <= 100" },
        "username": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "email":    { ".validate": "newData.isString() && newData.val().length <= 200" },
        "$other":   { ".validate": false }
      }
    },

    "Tasks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$taskId": {
          "taskId":   { ".validate": "newData.isString()" },
          "task":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
          "category": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "priority": { ".validate": "newData.isString() && newData.val().matches(/^(URGENT_AND_IMPORTANT|URGENT_BUT_NOT_IMPORTANT|NOT_URGENT_BUT_IMPORTANT|NOT_URGENT_AND_NOT_IMPORTANT)$/)" },
          "date":     { ".validate": "newData.isString() && newData.val().length <= 10" },
          "time":     { ".validate": "newData.isString() && newData.val().length <= 5" },
          "notes":    { ".validate": "newData.isString() && newData.val().length <= 500" },
          "repeat":   { ".validate": "newData.isString() && newData.val().matches(/^(daily|weekly|monthly)$/)" },
          "subtasks": {
            "$i": {
              "title":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
              "done":   { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            }
          },
          "$other":   { ".validate": false }
        }
      }
    },

    "Activity": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$day": { ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isNumber() && newData.val() >= 0" }
      }
    },

    "Stats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "statsId":        { ".validate": "newData.isString()" },
        "totalTasks":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "completedTasks": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "tasksToDo":      { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "totalScores":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other":         { ".validate": false }
      }
    }
  }
}
